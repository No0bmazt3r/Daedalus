# Build artefacts and deps — rebuilt inside the image
frontend/node_modules
frontend/dist
frontend/dist-ssr
backend/.venv
__pycache__
*.py[cod]

# Local state — provided at runtime via volumes, never baked in
backend/data
data
logs
*.log
*.db
*.db-wal
*.db-shm

# Local configuration — the image gets its values from compose
.env

# Repo/editor noise
.git
.github
.husky
.vscode
.idea
.DS_Store
*.local
test
images

# Docs aren't needed to run the app
docs
*.md
!README.md
