# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local configuration — .env.example is the tracked template
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Backend
backend/.venv
backend/data/
__pycache__/
*.py[cod]

# Runtime state. The directories themselves are tracked via .gitkeep so a
# fresh clone has them before Docker can create them as root-owned mounts.
/data/*
!/data/.gitkeep
!/data/sqlite/
/data/sqlite/*
!/data/sqlite/.gitkeep
!/data/documents/
/data/documents/*
!/data/documents/.gitkeep
/logs/*
!/logs/.gitkeep

# Vite cache
.vite
